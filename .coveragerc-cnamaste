# `cnamaste`'s own coverage gate (T- #670 PR1), separate from `port`'s.
#
# `cnamaste` is the copy of `cnaster`'s forward path that ships on its own,
# so it is measured on its own: the denominator is `python/cnamaste` and
# nothing else, under the tests marked `cnamaste`. `port`'s gates keep
# measuring `cnaster` and the oracle surface, unchanged; neither names this
# directory.
#
# Run by `python -m scripts.ci --badges` (and `--full`), with the JIT on:
# `numba` reports nothing for a compiled body, so the `@njit` kernels read as
# uncovered here however hard the whole runs exercise them. The same suite
# under `NUMBA_DISABLE_JIT=1` reads higher and runs slower; which of the two
# a figure was measured under is stated beside it, as `CLAUDE.md` asks.
[run]
# NB hyphenated, as `.coveragerc-dropin` explains: a dotted name reads as a
#    parallel-mode shard that `coverage erase` deletes.
data_file = .coverage-cnamaste
source =
    python/cnamaste

[report]
# The floor is the measurement, raised as each T- #670 PR lands and never
# lowered to pass one. 58.85% at PR1 (5405 statements, 2224 missed), JIT on,
# under `not release and cnamaste`: the gate instance's equivalence test.
# 61.92% at PR2 (5556 statements, 2116 missed), the same selection with the
# figure, plot-off and #105 / #113 tests added. 62.38% at PR3 (6460
# statements, 2430 missed), with dev and the preprocessing tests added.
# 62.42% at PR4 (6492 statements, 2440 missed), with the log-space kernel
# tests added. 64.15% at PR5 (6904 statements, 2475 missed), with the HMM
# fit-chain tests added.
fail_under = 64
precision = 2
