# The referee's own coverage, measured separately from the subject's.
#
# `pyproject.toml`'s gate measures `cnaster`, which is what this repository
# validates. This one measures how much of `snakes_and_ladders` is
# load-bearing for that validation -- how much of the oracle the claims
# actually rest on. Two different questions, so two floors: a figure that
# mixed them would rise for importing more upstream and read as progress.
#
# The denominator is the **oracle surface**, not all of upstream. Most of
# `snakes_and_ladders` -- the RL, the search, the codes -- is never a referee
# here, and a floor over 14,526 statements would be 7 per cent, unmovable, and
# would say nothing. These are the modules a referee comes from, and
# `tests/test_coverage_scope.py` refuses a test that imports one this list
# does not name.
#
# `ragged` joined when #667 landed, and `tests/test_coverage_scope.py` is
# what said so: the first fixture import of it failed the guard that
# refuses a referee the surface does not name.
#
# `opt/fit.py` joined with `main`'s `test_integer_copy.py`, which referees
# against it. The guard in `tests/test_coverage_scope.py` is what caught the
# omission on the merge, which is the job it was written for.
#
# **The surface is matched one way, from `cnaster`.** A module joins because
# the subject does something it referees, never because upstream ships it;
# `tests/test_oracle_correspondence.py` records the counterpart for each entry
# and refuses one without. Read the other way this denominator would grow on
# someone else's commits, and the figure would fall for every module upstream
# added.
#
# The rule bounds the opportunities as well as the entries. `emissions.py` is
# the largest module here, 779 statements, and most of it is out of reach by
# construction: 208 belong to the two families `cnaster` implements --
# negative binomial and beta-binomial -- plus their shared base, and 377 to
# Categorical, Gaussian, Poisson, Binomial and CountPair, which have no
# counterpart to referee. So its ceiling is **59 uncovered statements, not
# 401**. `CountPairEmission` is the instructive one: the fixtures draw counts
# through it, but drawing is the `upstream` role rather than the
# `upstream_oracle` one (#69), and a family that decides no expected value
# does not enter.
#
# `source` names the installed **directory** and `include` narrows it to the
# surface, for the reason `pyproject.toml` gives: naming modules instead lets
# coverage drop the ones no test imported, and the three at zero would leave
# the denominator rather than the floor. Measured: 2,085 statements by this
# form, 1,659 by the other, and the difference is exactly the part the number
# is supposed to be about.
[run]
source =
    .venv/lib/python3.12/site-packages/snakes_and_ladders

[report]
include =
    */snakes_and_ladders/emissions.py
    */snakes_and_ladders/opt/hmm.py
    */snakes_and_ladders/opt/fit.py
    */snakes_and_ladders/ragged.py
    */snakes_and_ladders/likelihood/forward_backward.py
    */snakes_and_ladders/likelihood/ragged_rust.py
    */snakes_and_ladders/likelihood/spatio_sequential.py
    */snakes_and_ladders/search/spatio_sequential.py
    */snakes_and_ladders/sim/count_pairs.py
    */snakes_and_ladders/sim/spatio_sequential.py
    */snakes_and_ladders/sim/graph.py
    */snakes_and_ladders/sim/hmm.py
    */snakes_and_ladders/search/alpha_expansion.py
# 924 of 2,164 statements, 42.70 per cent. `ragged.py` joined the surface when
# #667 landed and the fixture began planting unequal chromosomes against it;
# `opt/fit.py` joined with `main`'s `test_integer_copy.py`.
#
# Of that, the 42 tests marked `upstream_oracle` -- the agreement claims,
# where upstream decided the expected value -- reach 32.57 per cent on their
# own, so every other test in the suite adds 113 statements. The surface is
# the referee's and not the fixture's, measured rather than asserted, which is
# what #69 asks for.
#
# Recut 35.7 -> 35.5 on the #674 re-pin, and the direction is the
# denominator's rather than the numerator's: 801 covered of 2,238 became 803
# of 2,257, so upstream grew by nineteen statements and this suite reached two
# more of them. `CLAUDE.md`'s rule is that the floor is never lowered to pass
# a pull request; it is lowered here to follow a dependency that got larger,
# with the arithmetic stated so the distinction is checkable rather than
# claimed.
#
# `forward_backward` left zero when #97's first rung landed: `ragged_rust`
# referees `cnaster`'s forward recursion over the clone-stacked ragged batch
# and reaches its oracle underneath, 19.67 per cent. **Two** modules sit at
# zero now -- `likelihood.spatio_sequential` and `search.spatio_sequential` --
# and they are the fit-level half of that rung, which waits on #77 item 1.
# Upstream's #674 is the fix; the event that moves this figure is the pin
# moving, not a test here failing.
fail_under = 42.7
precision = 2
# **Upstream capability with no `cnaster` counterpart leaves the denominator.**
# The figure is coverage against what `cnaster` can do, not against what
# `snakes_and_ladders` ships, so a family upstream adds that the subject has no
# counterpart for must not dilute it. Without this the metric falls whenever
# upstream grows, which reads as a regression in this repository for work done
# in another.
#
# That is a different case from a module *joining* the surface. A join happens
# because a claim here started resting on it, so the rung is owed and the
# figure should fall until it is built -- `opt/fit` on #85, `alpha_expansion`
# on #127. This exclusion is the opposite: nothing here will ever referee
# against these, because `cnaster` implements a negative binomial and a
# beta-binomial and no other per-observation kernel
# (`tests/test_oracle_correspondence.py` derives that from the subject).
#
# coverage.py excludes the whole block when the matched line opens one, so
# naming the class is enough. `tests/test_oracle_correspondence.py` holds the
# same list and fails if upstream adds a family that is neither matched nor
# excluded, so the two cannot drift.
exclude_also =
    ^class CategoricalEmission
    ^class GaussianEmission
    ^class PoissonEmission
    ^class BinomialEmission
    ^class CountPairEmission

