# Rust
/target/

# Python
__pycache__/
*.pyc
.venv
.venv/
.pytest_cache/
.benchmarks/
.coverage
# NB the per-guard data files, named one by one rather than as `.coverage*`,
#    which would also match the tracked `.coveragerc-oracle`. The dotted form
#    is here for the shards coverage writes in parallel mode.
.coverage-dropin
.coverage-e2e
.coverage-oracle
.coverage-reach
# NB `cnaster` appends a fit record here on every run, so a tracked copy made
#    `git status` dirty after any invocation of the suite (#222). Untracked
#    rather than kept: nothing reads it, no test references it, and the rows
#    carry no commit or instance, so they were a log rather than a
#    measurement record. A tracked file that changes on every run trains a
#    reader to ignore `git status`, and the once it carries something real it
#    looks exactly like the noise.
cnaster.perf
.coverage.*
*.egg-info/
.ruff_cache/
.mypy_cache/

# In-place compiled extension from an editable install
python/port/*.so
python/port/*.pyd
python/port/*.dylib

# Sphinx build output
docs/_build/
