# Generated files keep this branch's copy on a merge rather than stopping it
# (#403). `python -m scripts.ci --install` defines the `badges` driver;
# `python -m scripts.ci --badges --record` then re-measures what the merged
# tree reads. Without the driver installed git falls back to its ordinary
# merge, so nothing breaks, it only conflicts. `docs/plots/` tracks no
# generated figure, so it has no line here.
.badges/*.json merge=badges

# Lines are appended, one per run and one per measured value, so two branches
# that each record a run both keep theirs (#409, #620).
docs/metrics/*.tsv merge=union
docs/metrics/cnaster/*.tsv merge=union
